{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pcmsgasc-club",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "club-db", "migrations_dir": "migrations" }],
  "durable_objects": { "bindings": [{ "name": "AUTH", "class_name": "Account" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Account"] }],
  "observability": { "enabled": false }
}
